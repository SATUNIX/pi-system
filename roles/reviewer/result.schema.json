{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviewer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "role",
    "summary",
    "confidence",
    "findings",
    "escalate"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "const": "reviewer"
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "suspected",
              "unknown"
            ]
          }
        }
      }
    },
    "escalate": {
      "type": "boolean"
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "mr_plan": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        null
      ]
    },
    "rollback_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
