{
  "name": "lite",
  "description": "Low-context set for small local models: default-deny firewall, checkpoints, todo, verification, context sieve, cheap readseek navigation, and a trimmed skill/prompt list.",
  "firewall": { "mode": "manual", "policy": "coding" },
  "skills": {
    "only": [
      "coding-agent-workflow", "codebase-navigation", "task-decomposition", "patch-hygiene",
      "verification-loop", "recovery-debugging", "mcp-tool-use", "small-model-execution",
      "agent-orchestration", "self-reflection-and-recovery", "context-management", "memory"
    ]
  },
  "prompts": {
    "only": ["code-orient", "code-plan", "code-verify", "code-compact"]
  },
  "include": [
    "protected-paths", "tool-firewall", "git-checkpoint", "custom-footer", "session-helpers", "kit-update", "effort", "delegation-guard",
    "compress", "save", "trace-ledger", "progress-guard", "todo", "verify-gate", "verifier-board",
    "context-sieve", "caveman", "pi-readseek",
    "subagent", "orchestrator", "goal-core"
  ]
}
