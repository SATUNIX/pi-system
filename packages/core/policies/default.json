  "policies": {
    "pentest": {
      "command_rules": {
        "deny": [
          {
            "pattern": "\\brm\\s+(?:-\\S*\\s+)*-(?:[a-zA-Z]*[rR][a-zA-Z]*|-recursive)\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "recursive delete (rm -r)"
          },
          {
            "pattern": "\\bshred\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "secure file wipe"
          },
          {
            "pattern": "\\bdd\\s+if=",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "raw disk/image write"
          },
          {
            "pattern": "\\bmkfs\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "filesystem format"
          },
          {
            "pattern": "\\bchmod\\s+777\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "world-writable permissions"
          },
          {
            "pattern": "\\bchown\\b[^\\n]*\\s\\/(?:\\s|$)",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "chown of filesystem root"
          },
          {
            "pattern": "\\bfind\\b[^\\n]*\\s-delete\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "find -delete sweep"
          },
          {
            "pattern": "\\bkubectl\\s+delete\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "kubernetes resource deletion"
          },
          {
            "pattern": "\\bdocker\\s+(?:rm|rmi|system\\s+prune|volume\\s+rm)\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "docker resource removal"
          },
          {
            "pattern": "\\btruncate\\s+-s\\s+0\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "truncate file to zero"
          },
          {
            "pattern": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
            "flags": "",
            "risk_class": "destructive",
            "reason": "fork bomb"
          },
          {
            "pattern": ">\\s*/dev/sd[a-z]",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "write to raw block device"
          },
          {
            "pattern": "\\bremove-item\\b[^\\n]*-recurse\\b",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "PowerShell recursive delete (Remove-Item -Recurse)"
          },
          {
            "pattern": "(?:require\\(['\"]fs['\"]\\)|\\bfs)(?:\\.promises)?\\.rm(?:Sync)?\\s*\\([^)]*recursive\\s*:\\s*true",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "Node recursive delete (fs.rmSync/fs.rm with recursive:true)"
          },
          {
            "pattern": "\\bgit\\s+clean\\b[^\\n]*-\\S*f",
            "flags": "i",
            "risk_class": "destructive",
            "reason": "git clean force-removes untracked files"
          }
        ],
        "ask": [
          {
            "pattern": "\\bsudo\\b",
            "flags": "i",
            "risk_class": "privilege",
            "reason": "privilege escalation"
          },
          {
            "pattern": "\\bchmod\\s+-R\\b",
            "flags": "i",
            "risk_class": "permissions",
            "reason": "recursive permission change"
          },
          {
            "pattern": "(?:curl|wget)\\b[^\\n|]*\\|\\s*(?:sudo\\s+)?(?:ba)?sh\\b",
            "flags": "i",
            "risk_class": "remote_exec",
            "reason": "pipe remote script to shell"
          },
          {
            "pattern": "\\bgit\\s+push\\b[^\\n]*--force",
            "flags": "i",
            "risk_class": "history_rewrite",
            "reason": "force push"
          },
          {
            "pattern": "\\bgit\\s+reset\\s+--hard\\b",
            "flags": "i",
            "risk_class": "history_rewrite",
            "reason": "hard reset discards changes"
          },
          {
            "pattern": "\\bnpm\\s+publish\\b",
            "flags": "i",
            "risk_class": "supply_chain",
            "reason": "package publish"
          },
          {
            "pattern": "\\bssh\\b",
            "flags": "i",
            "risk_class": "remote_access",
            "reason": "SSH remote access (also covers commands run on a remote host over SSH)"
          },
          {
            "pattern": "\\baws\\s",
            "flags": "i",
            "risk_class": "cloud_control",
            "reason": "AWS CLI cloud control-plane action"
          }
        ]
      }
    }
  }
}
