# syntax=docker/dockerfile:1
#
# Role-runner image (WP-070, TLP2-SPEC 08 §7).
#
# REPLACE_WITH_PIN: the base image must be pinned by digest and the resulting
# image signed with cosign before any production use. `pi-agents` is `pending`
# in gitops/versions.lock.yaml, and the shared image pipeline (WP-081) is not
# proven, so this file is deliberately not wired to an automatic build yet.
#
# Hardening: non-root UID 10001, no shell/tooling beyond node and the runner,
# read-only root filesystem compatible (only /work, /inputs, /outputs are
# mounted writable), no secrets baked in. Node 22.18+ strips TypeScript types,
# so the runner has zero runtime dependencies.

ARG NODE_IMAGE=node:22-alpine

# --- check: run the offline contract test at build time -----------------------
FROM ${NODE_IMAGE} AS check
WORKDIR /src/pi-system
COPY roles ./roles
COPY tests/role-runner-smoke.mjs ./tests/role-runner-smoke.mjs
COPY packages/role-runner ./packages/role-runner
RUN node tests/role-runner-smoke.mjs

# --- runtime ------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
RUN addgroup -g 10001 -S piagent \
 && adduser -S -D -H -u 10001 -G piagent -s /sbin/nologin piagent \
 && mkdir -p /opt/pi-system /work /inputs /outputs \
 && chown -R 10001:10001 /work /inputs /outputs

COPY --from=check --chown=10001:10001 /src/pi-system/roles /opt/pi-system/roles
COPY --from=check --chown=10001:10001 /src/pi-system/packages/role-runner /opt/pi-system/packages/role-runner
RUN ln -s /opt/pi-system/packages/role-runner/bin/pi.mjs /usr/local/bin/pi \
 && chmod +x /opt/pi-system/packages/role-runner/bin/pi.mjs

# Configuration is files + env only (08 §7). The LiteLLM key is never passed as
# a workflow parameter; the entrypoint writes it to a tmpfs and sets
# PI_LITELLM_API_KEY_FILE after OpenBao Kubernetes auth.
ENV PI_ROLES_DIR=/opt/pi-system/roles \
    PI_INPUT=/inputs/context.json \
    PI_OUTPUT=/outputs/result.json \
    HOME=/work \
    NODE_ENV=production

USER 10001:10001
WORKDIR /work
ENTRYPOINT ["node", "/opt/pi-system/packages/role-runner/bin/pi.mjs"]
CMD ["run", "--help"]
