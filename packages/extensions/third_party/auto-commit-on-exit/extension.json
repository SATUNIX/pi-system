{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "auto-commit-on-exit",
  "summary": "Automatically commits uncommitted changes when the pi session shuts down, using the last assistant message as the commit message.",
  "category": "execution",
  "tier": "T0",
  "layer": 1,
  "entry": "index.ts",
  "hooks": ["session_shutdown"],
  "registers": { "tools": [], "commands": [] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": [],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [],
  "provenance": { "origin": "vendored" },
  "homeRepo": null,
  "status": "stable"
}
