{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "git-checkpoint",
  "summary": "Creates git stash checkpoints at each turn so /fork can restore code state to any prior point.",
  "category": "execution",
  "tier": "T0",
  "layer": 1,
  "entry": "index.ts",
  "hooks": ["session_start", "tool_result", "turn_start", "session_before_fork"],
  "registers": { "tools": [], "commands": [] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": [],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [],
  "provenance": { "origin": "vendored" },
  "homeRepo": null,
  "status": "stable"
}
