{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "custom-compaction",
  "summary": "Warning-only compatibility shim: reports that template injection into compaction is unsupported by the current Pi API and leaves native summarization intact. Superseded by context-sieve at T3+ (long-horizon profile).",
  "category": "workflow",
  "tier": "T1",
  "layer": 3,
  "entry": "index.ts",
  "hooks": ["session_start", "session_before_compact"],
  "registers": { "tools": [], "commands": [] },
  "profiles": ["balanced"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:path"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": ["PI_KIT_COMPACT_TEMPLATE"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "stable"
}
