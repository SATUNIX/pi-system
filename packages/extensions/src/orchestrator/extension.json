{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "orchestrator",
  "summary": "Autonomous delegation layer. Materializes planner/implementer/reviewer/scout role agents into .pi/agents, scores task complexity, and — when a task is non-trivial — steers the main agent to run a plan → implement → validate flow via the subagent tool (context-sieve contribution, never direct system-prompt injection).",
  "category": "planning",
  "tier": "T3",
  "layer": 4,
  "entry": "index.ts",
  "hooks": ["session_start", "input", "tool_result", "turn_end"],
  "registers": { "tools": [], "commands": ["/orchestrate", "/orchestrate-plan", "/orchestrate-implement-review"] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:path", "node:url"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": ["subagent"],
  "env": ["PI_KIT_ORCH_THRESHOLD", "PI_KIT_ORCH_DISABLE"],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}
