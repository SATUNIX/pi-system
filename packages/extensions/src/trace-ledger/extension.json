{
  "$schema": "../../../core/schema/extension.schema.json",
  "name": "trace-ledger",
  "summary": "Structured action ledger. Records every tool call and result to .pi/trace.jsonl, warns on repeated reads, and exposes /trace. The facts layer for efficiency and anti-loop tooling.",
  "category": "execution",
  "tier": "T1-T4",
  "layer": 6,
  "entry": "index.ts",
  "hooks": ["session_start", "tool_call", "tool_result", "turn_end"],
  "registers": { "tools": [], "commands": ["trace"] },
  "profiles": ["quick", "balanced", "long-horizon", "autonomous", "self-improving", "pentest", "lite"],
  "enabledByDefault": true,
  "platforms": ["windows", "linux", "darwin"],
  "runtime": {
    "nodeBuiltins": ["node:fs", "node:path", "node:crypto"],
    "npm": [],
    "piPeers": [],
    "services": [],
    "models": []
  },
  "pulls": [],
  "env": [],
  "provenance": { "origin": "custom" },
  "homeRepo": null,
  "status": "beta"
}
